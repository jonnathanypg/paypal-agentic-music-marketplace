# ==============================================================================
#  PayPal Agentic Music Marketplace (exito.cyou) — Environment Configuration
# ==============================================================================
#  NEVER commit real secrets. This file documents the required variables only.
# ==============================================================================

# ── PayPal Live App (normal production checkout) ──
PAYPAL_CLIENT_ID=your_live_client_id_here
PAYPAL_CLIENT_SECRET=your_live_client_secret_here
PAYPAL_MODE=live

# ── PayPal Sandbox App (judges / ?sandbox=1 demo mode) ──
# Create a separate app at https://developer.paypal.com/ → Apps & Credentials → Sandbox
PAYPAL_SANDBOX_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret_here

# ── Next.js public credentials (embedded at build time) ──
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_live_client_id_here
NEXT_PUBLIC_PAYPAL_SANDBOX_CLIENT_ID=your_sandbox_client_id_here

# ── Multi-Agent AI Core & LLM ──
OPENAI_API_KEY=your_openai_api_key_optional
ANTHROPIC_API_KEY=your_anthropic_api_key_optional
GEMINI_API_KEY=your_google_ai_studio_key_optional

# ── Backend & Microservices Routing ──
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./mediasuite.db
SECRET_KEY=generate_a_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256

# ── Host / Domain ──
NEXT_PUBLIC_SITE_URL=https://exito.cyou
PORT=3005
