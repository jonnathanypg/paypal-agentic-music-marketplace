# ==============================================================================
#  PayPal Agentic Music Marketplace (exito.cyou) — Environment Configuration
# ==============================================================================

# ── PayPal Developer Platform (Sandbox & Live) ──
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox # Use "sandbox" for judging & testing, "live" for production

# ── Next.js Public PayPal Credentials ──
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ── Multi-Agent AI Core & LLM ──
OPENAI_API_KEY=your_openai_api_key_optional
ANTHROPIC_API_KEY=your_anthropic_api_key_optional

# ── Backend & Microservices Routing ──
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./mediasuite.db
SECRET_KEY=generate_a_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256

# ── Host / Domain ──
NEXT_PUBLIC_SITE_URL=https://exito.cyou
PORT=3005
