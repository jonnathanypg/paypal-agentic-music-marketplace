# ==============================================================================
#  PayPal Agentic Music Marketplace (exito.cyou) — Environment Configuration
# ==============================================================================
#  NEVER commit real secrets. Copy this file to `.env` and fill only what you
#  need. The app runs fully offline with the demo checkout enabled by default.
# ==============================================================================

# ── PayPal Live App (real production checkout; optional locally) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── PayPal Sandbox App (optional; enables ?sandbox=1 with a real sandbox buyer) ──
# Create a separate app at https://developer.paypal.com/ → Apps & Credentials → Sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# ── Next.js public credentials (embedded at build time) ──
# Leave empty to use the local demo checkout instead of the PayPal SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_SANDBOX_CLIENT_ID=

# ── Local judge demo checkout (no PayPal account or credentials required) ──
# The UI shows a clearly labelled "demo" button that records a purchase without
# charging money. Backend rejects it when ALLOW_DEMO_CHECKOUT is not enabled.
NEXT_PUBLIC_DEMO_CHECKOUT=1
ALLOW_DEMO_CHECKOUT=1

# ── Multi-Agent AI Core & LLM (optional) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Backend & Microservices Routing ──
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite:///./mediasuite.db
SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256

# ── Host / Domain ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3005
